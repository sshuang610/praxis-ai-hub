# Server-side model provider config
DASHSCOPE_API_KEY=replace-with-your-key
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Supabase config
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Model controls
ALLOWED_MODELS=qwen-turbo,qwen-plus,qwen-max,qwen-coder-plus,qwen-vl-max
NEXT_PUBLIC_ALLOWED_MODELS=qwen-turbo,qwen-plus,qwen-max,qwen-coder-plus,qwen-vl-max
NEXT_PUBLIC_DEFAULT_MODEL=qwen-max

# Server-side short memory default (turns)
MAX_TURNS=8
